# ULPF V2 Backend Environment Variables

# Server Configuration
PORT=8000
HOST=0.0.0.0

# Database
# Default to PostgreSQL to avoid SQLite Windows locking issues
DATABASE_URL=postgresql://ulpf:ulpf@localhost:5432/ulpf

# Runtime Mode
ULPF_MODE=dev

# Automatically seed the database with demo users/rules on startup
ULPF_SEED_DEMO_DATA=true

# Set to true to mock the local LLM generation for testing without a GPU or model file.
ULPF_MOCK_LLM=false

# Set QUEUE_BACKEND to memory to bypass Redis timeout issues on native Windows
QUEUE_BACKEND=memory

# Local model path (if ULPF_MOCK_LLM is false)
# The GGUF model file must be placed here.
ULPF_MODEL_PATH=app/models/Qwen2.5-Coder-7B-Instruct-Q4_K_M.gguf

# Demo Credentials (Override in production!)
POSTGRES_USER=ulpf
POSTGRES_PASSWORD=ulpf
POSTGRES_DB=ulpf
OPENSEARCH_INITIAL_ADMIN_PASSWORD=StrongPassword123!
ADMIN_USERNAME=admin
ADMIN_PASSWORD=ulpf-admin

# Secrets (Override in production with secure values!)
SECRET_KEY=changeme-in-production-minimum-32-characters
MASK_HMAC_KEY=changeme-mask-key-minimum-32-chars
